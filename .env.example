# Configuracion de variables de entorno para el Clasificador de Residuos
# Copia este archivo como .env para desarrollo local o referencia de despliegue

# Region de AWS donde se despliegan los servicios
AWS_REGION=us-east-1

# Nombre del bucket S3 para almacenamiento temporal de fotos (prefijo uploads/)
BUCKET=clasificador-fotos-temp-123456

# Nombre de la tabla DynamoDB para almacenar resultados de clasificacion
TABLE=clasificador-residuos

# Origen permitido para CORS (usa '*' en desarrollo o el dominio HTTPS de CloudFront en produccion)
# Ejemplo produccion: ALLOWED_ORIGIN=https://d111111abcdef8.cloudfront.net
ALLOWED_ORIGIN=*

# URL base de invocacion generada por Amazon API Gateway (para el frontend)
# Ejemplo: API_BASE_URL=https://abc123xyz.execute-api.us-east-1.amazonaws.com/prod
API_BASE_URL=https://tu-api-id.execute-api.us-east-1.amazonaws.com/prod
